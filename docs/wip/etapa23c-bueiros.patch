diff --git a/src/SinalizacaoViaria.Core/Generators/CulvertGenerator.cs b/src/SinalizacaoViaria.Core/Generators/CulvertGenerator.cs
new file mode 100644
index 0000000..ba84054
--- /dev/null
+++ b/src/SinalizacaoViaria.Core/Generators/CulvertGenerator.cs
@@ -0,0 +1,74 @@
+using SinalizacaoViaria.Core.Definitions;
+using SinalizacaoViaria.Core.Geometry;
+using SinalizacaoViaria.Core.Model;
+
+namespace SinalizacaoViaria.Core.Generators;
+
+/// <summary>
+/// Bueiro em 3D: as linhas de tubo (sólidos de revolução ocos) ou as células (laje de fundo, laje de topo e paredes), do fundo
+/// da entrada ao da saída, e os muros de testa nas bocas (0,30 m de espessura, 0,50 m além do conjunto de cada lado e acima
+/// dele – padrão do plugin).
+/// </summary>
+public static class CulvertGenerator
+{
+    public const double TestaEspessura = 0.30;
+    public const double TestaFolga = 0.50;
+
+    public static MarkingGeometry Build(BueiroDefinition b, Polyline2? path)
+    {
+        var geo = new MarkingGeometry();
+        if (path == null || path.Points.Count < 2)
+        {
+            geo.Warnings.Add("Bueiro: eixo não encontrado.");
+            return geo;
+        }
+        // Reto da entrada à saída (os pontos do meio não contam).
+        var eixo = new Polyline2(new[] { path.Points[0], path.Points[^1] }, false);
+        var L = eixo.Length;
+        if (L < 0.5) { geo.Warnings.Add("Bueiro: as bocas estão a menos de 0,5 m."); return geo; }
+        if (b.CotaSaida >= b.CotaEntrada) geo.Warnings.Add("Bueiro: o fundo da saída não está abaixo do da entrada.");
+        double Z(double s) => b.CotaEntrada + (b.CotaSaida - b.CotaEntrada) * s / L;
+        var u = (eixo.Points[1] - eixo.Points[0]) * (1 / L);
+        var nrm = u.PerpLeft;
+        var t = b.ParedeEfetiva;
+        var k = Math.Max(1, b.Celulas);
+        var W = b.LarguraTotal;
+        // Extensão do quantitativo: o eixo × as linhas ou células.
+        geo.PaintedLength = L * k;
+        if (b.Forma == FormaBueiro.Circular)
+        {
+            var r = b.Diametro / 2;
+            var passo = b.Diametro + 2 * t + Math.Max(0, b.Afastamento);
+            for (int i = 0; i < k; i++)
+            {
+                var o = (i - (k - 1) / 2.0) * passo;
+                var a = eixo.Points[0] + nrm * o;
+                var c = eixo.Points[1] + nrm * o;
+                // O fundo interno na cota informada: o centro fica r acima.
+                SolidSweep.AddRound(geo, Vec3.At(a, b.CotaEntrada + r), Vec3.At(c, b.CotaSaida + r), r + t, r + t, MarkingColor.Concreto, "BUEIRO", false, r, r, 32);
+            }
+        }
+        else
+        {
+            // Lajes de fundo e de topo e as k + 1 paredes.
+            SolidSweep.Along(geo, eixo, s => SolidSweep.Rect(-W / 2, W / 2, Z(s) - t, Z(s)), MarkingColor.Concreto, 0, L, 4, "BUEIRO");
+            SolidSweep.Along(geo, eixo, s => SolidSweep.Rect(-W / 2, W / 2, Z(s) + b.Altura, Z(s) + b.Altura + t), MarkingColor.Concreto, 0, L, 4, "BUEIRO");
+            for (int j = 0; j <= k; j++)
+            {
+                var y0 = -W / 2 + j * (b.Largura + t);
+                SolidSweep.Along(geo, eixo, s => SolidSweep.Rect(y0, y0 + t, Z(s), Z(s) + b.Altura), MarkingColor.Concreto, 0, L, 4, "BUEIRO");
+            }
+        }
+        if (b.Testas)
+        {
+            var h = b.AlturaTotal + TestaFolga;
+            var largura = W / 2 + TestaFolga;
+            foreach (var (s0, s1, z) in new[] { (0.0, Math.Min(L, TestaEspessura), b.CotaEntrada), (Math.Max(0, L - TestaEspessura), L, b.CotaSaida) })
+            {
+                var zb = z - (b.Forma == FormaBueiro.Celular ? t : 0) - 0.20;
+                SolidSweep.Along(geo, eixo, _ => SolidSweep.Rect(-largura, largura, zb, zb + h + 0.20), MarkingColor.Concreto, s0, s1, 1, "TESTA");
+            }
+        }
+        return geo;
+    }
+}
