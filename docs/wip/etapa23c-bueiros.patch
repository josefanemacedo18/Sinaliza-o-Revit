@@ -0,0 +1,62 @@
+using SinalizacaoViaria.Core.Geometry;
+
+namespace SinalizacaoViaria.Core.Definitions;
+
+public enum FormaBueiro
+{
+    /// <summary>Tubos circulares (uma ou mais linhas).</summary>
+    Circular,
+    /// <summary>Células retangulares (galeria celular de uma ou mais células).</summary>
+    Celular,
+}
+
+/// <summary>
+/// Bueiro (Etapa 22): travessia de um talvegue sob a via, da boca de entrada (primeiro ponto, a montante) à de saída, com as
+/// cotas de fundo nas duas bocas (absolutas – o caminho fica na cota 0), a forma (tubos circulares ou células retangulares), o
+/// número de linhas ou células, as dimensões internas, o material e a rugosidade, a vazão de projeto informada (com a fonte) e
+/// os muros de testa. A capacidade é verificada a seção plena por Manning; o controle de entrada não é calculado.
+/// </summary>
+public sealed class BueiroDefinition : MarkingDefinition
+{
+    public PathReference PathRef { get; set; } = new();
+    public string Nome { get; set; } = "";
+    public FormaBueiro Forma { get; set; } = FormaBueiro.Circular;
+    /// <summary>Linhas de tubo ou células.</summary>
+    public int Celulas { get; set; } = 1;
+    /// <summary>Circular: diâmetro interno (m).</summary>
+    public double Diametro { get; set; } = 1.0;
+    /// <summary>Celular: vão interno de cada célula (m).</summary>
+    public double Largura { get; set; } = 2.0;
+    /// <summary>Celular: altura interna (m).</summary>
+    public double Altura { get; set; } = 2.0;
+    /// <summary>Espessura das paredes (m); nula = a do desenho (circular: 8 % do diâmetro, mínimo 4 cm; celular: 0,20 m) – padrão do plugin.</summary>
+    public double? Parede { get; set; }
+    /// <summary>Circular: afastamento livre entre as linhas de tubo (m) – padrão do plugin.</summary>
+    public double Afastamento { get; set; } = 0.30;
+    /// <summary>Cota de fundo na boca de entrada (m).</summary>
+    public double CotaEntrada { get; set; }
+    /// <summary>Cota de fundo na boca de saída (m).</summary>
+    public double CotaSaida { get; set; }
+    public string Material { get; set; } = "concreto";
+    /// <summary>Rugosidade de Manning; nula = a do Projeto de Drenagem.</summary>
+    public double? Rugosidade { get; set; }
+    /// <summary>Vazão de projeto (L/s), da bacia, informada pelo usuário; nula = só a capacidade.</summary>
+    public double? VazaoProjeto { get; set; }
+    /// <summary>De onde vem a vazão de projeto (estudo hidrológico, método, como o usuário escrever).</summary>
+    public string? FonteVazao { get; set; }
+    /// <summary>Muros de testa nas duas bocas (desenho e quantitativo).</summary>
+    public bool Testas { get; set; } = true;
+
+    public double ParedeEfetiva => Parede ?? (Forma == FormaBueiro.Circular ? Math.Max(0.04, Diametro / 2 * 0.16) : 0.20);
+    /// <summary>Largura externa do conjunto (m).</summary>
+    public double LarguraTotal => Forma == FormaBueiro.Circular
+        ? Math.Max(1, Celulas) * (Diametro + 2 * ParedeEfetiva) + (Math.Max(1, Celulas) - 1) * Math.Max(0, Afastamento)
+        : Math.Max(1, Celulas) * Largura + (Math.Max(1, Celulas) + 1) * ParedeEfetiva;
+    /// <summary>Altura externa (m).</summary>
+    public double AlturaTotal => Forma == FormaBueiro.Circular ? Diametro + 2 * ParedeEfetiva : Altura + 2 * ParedeEfetiva;
+
+    public override string KindName => "Bueiro";
+    public override string DisplayCode => Forma == FormaBueiro.Circular ? "BUEIRO-TUBO" : "BUEIRO-CEL";
+    public override PathReference? Path => PathRef;
+    public override void SetPath(PathReference path) => PathRef = path;
+}
