@@ -0,0 +1,76 @@
+using System.Globalization;
+using SinalizacaoViaria.Core.Definitions;
+using SinalizacaoViaria.Core.Geometry;
+
+namespace SinalizacaoViaria.Core.Automation;
+
+/// <summary>Verificação de um bueiro: extensão, declividade, capacidade a seção plena, velocidade e ocupação pela vazão informada.</summary>
+public sealed record VerificacaoBueiro(string Id, string Nome, double Extensao, double Declividade, double AreaUtil, double Capacidade, double Velocidade,
+    double? Vazao, double? Ocupacao);
+
+/// <summary>
+/// Bueiros (Etapa 22): capacidade a seção plena por Manning em cada linha ou célula (circular: R = D/4; celular: R = b·h /
+/// 2(b + h)), somada; a ocupação pela vazão de projeto informada. O controle de entrada (FHWA HDS-5) e a condição de jusante
+/// não são calculados – a verificação diz isso.
+/// </summary>
+public static class Bueiros
+{
+    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-BR");
+    private static string N(double v, string f = "0.00") => v.ToString(f, Pt);
+
+    public static string Rotulo(BueiroDefinition b) =>
+        $"{b.KindName}{(string.IsNullOrWhiteSpace(b.Nome) ? "" : " " + b.Nome.Trim())}";
+
+    /// <summary>Dimensões no texto: "2 × Ø 1000 mm" ou "1 × 2,00 × 2,00 m".</summary>
+    public static string Dimensoes(BueiroDefinition b) => b.Forma == FormaBueiro.Circular
+        ? $"{Math.Max(1, b.Celulas)} × Ø {N(b.Diametro * 1000, "0")} mm"
+        : $"{Math.Max(1, b.Celulas)} × {N(b.Largura)} × {N(b.Altura)} m";
+
+    public static VerificacaoBueiro Verificar(BueiroDefinition b, ProjetoDrenagem? p)
+    {
+        var pts = b.PathRef.Points;
+        var L = pts.Count >= 2 ? pts[0].DistanceTo(pts[^1]) : 0;
+        var s = L > 1e-6 ? (b.CotaEntrada - b.CotaSaida) / L : 0;
+        var n = b.Rugosidade ?? p?.Rugosidade ?? 0.013;
+        var k = Math.Max(1, b.Celulas);
+        double area, q;
+        if (b.Forma == FormaBueiro.Circular)
+        {
+            area = Math.PI * b.Diametro * b.Diametro / 4;
+            q = Hidraulica.SecaoPlena(b.Diametro, s, n).Vazao;
+        }
+        else
+        {
+            area = b.Largura * b.Altura;
+            var r = area / (2 * (b.Largura + b.Altura));
+            q = s > 0 && n > 0 ? area * Math.Pow(r, 2.0 / 3) * Math.Sqrt(s) / n : 0;
+        }
+        var cap = q * k * 1000;
+        var v = area > 0 ? q / area : 0;
+        double? oc = b.VazaoProjeto is { } qp && cap > 1e-9 ? qp / cap : null;
+        return new VerificacaoBueiro(b.Id, Rotulo(b), L, s, area * k, cap, v, b.VazaoProjeto, oc);
+    }
+
+    /// <summary>Problemas dos bueiros (a tela da rede e o Validar Modelo): declividade nula ou contrária e vazão acima da capacidade.</summary>
+    public static List<ProblemaRede> Problemas(IReadOnlyCollection<MarkingDefinition> defs, ProjetoDrenagem? p)
+    {
+        var res = new List<ProblemaRede>();
+        foreach (var b in defs.OfType<BueiroDefinition>())
+        {
+            var v = Verificar(b, p);
+            var ids = new[] { b.Id };
+            if (v.Extensao < 0.5) { res.Add(new(v.Nome, "bueiro", $"{v.Nome}: sem as duas bocas (eixo com menos de 0,5 m).", false, ids)); continue; }
+            if (v.Declividade <= 0)
+                res.Add(new(v.Nome, "bueiro", $"{v.Nome}: fundo da saída ({N(b.CotaSaida, "0.000")} m) não está abaixo do da entrada ({N(b.CotaEntrada, "0.000")} m) – " +
+                    "sem escoamento por gravidade.", false, ids));
+            else if (v.Vazao is { } q && q > v.Capacidade + 1e-6)
+                res.Add(new(v.Nome, "bueiro", $"{v.Nome} ({Dimensoes(b)}): vazão de projeto {N(q)} L/s acima da capacidade a seção plena {N(v.Capacidade)} L/s" +
+                    (string.IsNullOrWhiteSpace(b.FonteVazao) ? "" : $" (vazão: {b.FonteVazao!.Trim()})") + ".", false, ids));
+        }
+        return res;
+    }
+
+    /// <summary>Extremos do eixo de cada bueiro (para a travessia dos talvegues sob as vias).</summary>
+    public static IEnumerable<(Vec2 A, Vec2 B)> Eixos(IEnumerable<MarkingDefinition> defs) =>
+        defs.OfType<BueiroDefinition>().Where(b => b.PathRef.Points.Count >= 2).Select(b => (b.PathRef.Points[0], b.PathRef.Points[^1]));
+}
