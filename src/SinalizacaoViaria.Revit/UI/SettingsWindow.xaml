<Window x:Class="SinalizacaoViaria.Revit.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações – SinalizaBIM" Width="860" Height="700" MinHeight="480" MinWidth="600">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizaBIM;component/UI/Styles.xaml"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="SvWindow"/>
    </Window.Style>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Autoteste (diagnóstico)…" Click="AutoTestClick" Margin="0,0,24,0"
                    ToolTip="Roda uma amostra das ferramentas numa área de teste (modo rápido: até 3 minutos) e gera um relatório de erros. Tudo é desfeito no fim."/>
            <Button Content="Salvar" Style="{StaticResource Primary}" Click="SaveClick" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="TxtCabecalho" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Configurações do usuário ficam neste computador (não vão com o projeto); as do projeto ficam gravadas no modelo e as de cada elemento, nele. Salvar valida tudo antes e diz o que muda – nada é alterado nos elementos existentes sem um comando."/>
        <TabControl x:Name="Tabs">
        <TabItem Header="Do usuário (este computador)">
        <DockPanel>
        <StackPanel DockPanel.Dock="Top" x:Name="PanelValidacao" Margin="0,4,0,6"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Geral e documentação (padrões de criação)">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Representação" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbMode"/>
                        <TextBlock Grid.Row="1" Text="Material" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbMaterial"/>
                        <TextBlock Grid.Row="2" Text="Velocidade padrão (km/h)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbSpeed"/>
                        <TextBlock Grid.Row="3" Text="Fonte das legendas" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbFont"/>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="CkBold" Content="Legendas em negrito"/>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Desempenho e modelo 3D">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Espessura mínima modelada (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="TbMinThickness" ToolTip="Películas de tinta reais são finas demais para sólidos do Revit; recomenda-se 0,003 m."/>
                        <TextBlock Grid.Row="1" Text="Elevação adicional padrão (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbElevation"/>
                        <CheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="CkDrape" Content="Acompanhar superfícies por padrão"/>
                        <TextBlock Grid.Row="3" Text="Comprimento máx. das peças na projeção (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbPiece"/>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Sistema viário e comportamento">
                    <StackPanel>
                        <CheckBox x:Name="CkAuto" Content="Atualizar marcas automaticamente quando as linhas de referência mudarem"/>
                        <CheckBox x:Name="CkAutoIntersect" Content="Criar/atualizar interseções automaticamente quando as vias se cruzam" IsChecked="True"/>
                        <CheckBox x:Name="CkFloors" Content="Pavimento, calçada, meio-fio, sarjeta e grama como Piso do Revit (editáveis com as ferramentas nativas)" IsChecked="True"/>
                        <CheckBox x:Name="CkRampFloors" Margin="20,0,0,0" Content="Rampas e guias rebaixadas também como Piso (fundo plano, topo inclinado)" IsChecked="True"
                                  ToolTip="Cada parte da rampa (rampa, abas, platô, patamar) vira um piso com camada de espessura variável: a edição de forma inclina só o topo. Entra nos quantitativos de pisos e na conferência piso × terreno. Desmarcado: forma direta, como até a 2.21."/>
                        <CheckBox x:Name="CkPaintFloors" Content="Sinalização horizontal (linhas, zebrados, setas, legendas, vagas) como Piso do Revit fino sobre o pavimento" IsChecked="True"
                                  ToolTip="Cada marca vira um piso por cor (vários contornos num só piso), com o material da pintura – edite o esboço do piso para ajustar traços e áreas. Desmarcado: forma direta (DirectShape)."/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2"
                                    ToolTip="Curvas viram arcos e retas viram uma linha só no esboço dos pisos e formas (modelo leve, sem 'tracinhos'). Desvio máximo nos pontos do traçado. 0 = uma reta por vértice, como antes.">
                            <TextBlock Text="Contornos com linhas e arcos inteiros – desvio máximo (mm)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TbBoundaryTol" Width="60"/>
                        </StackPanel>
                        <CheckBox x:Name="CkAutoCrosswalks" Content="Interseções automáticas com faixas de pedestres e rebaixamentos" IsChecked="False"/>
                        <CheckBox x:Name="CkAutoConnect" Content="Ímã de conexão: ponta de via solta sobre outra via encaixa no eixo dela (e vias ligadas acompanham)" IsChecked="True"/>
                        <CheckBox x:Name="CkBoundary" Content="Contorno visível nas regiões 2D (recomendado para marcas brancas)"/>
                        <CheckBox x:Name="CkRealistic" Content="Materiais com a aparência realista da biblioteca do Revit (modo Realista)" IsChecked="True"
                                  ToolTip="Asfalto, concreto, bloquete, terra, brita, grama, metal, vidro, madeira e água recebem o ativo de aparência da biblioteca instalada com o Revit, na escala dele. A cor de Cores consistentes não muda; materiais que já têm aparência não são tocados; as pinturas ficam na cor lisa."/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Geometria, topografia e diagnósticos – limites geométricos do traçado e do greide">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Informe os limites da norma e da classe da via adotadas no projeto. O plugin não traz valores normativos: campo vazio não é conferido. O resultado sai no Perfil da Via (CSV de verificação) e no Validar Modelo (V12; a declividade do terreno, no V14)."/>
                        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Perfil" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CbPerfil" MinWidth="220" SelectionChanged="PerfilChanged"
                                          ToolTip="Limites guardados com um nome (e a fonte, quando informada) para reaplicar em outros projetos."/>
                                <Button Content="Aplicar" Click="AplicarPerfilClick" ToolTip="Preenche os limites com os do perfil escolhido (só salvar grava)."/>
                                <Button Content="Salvar como perfil…" Click="SalvarPerfilClick" ToolTip="Guarda os limites e a fonte atuais com um nome."/>
                                <Button Content="Excluir" Click="ExcluirPerfilClick"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtPerfil" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Fonte (norma, edição, tabela, classe)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbCritFonte"/>
                        <TextBlock Grid.Row="2" Text="Raio mínimo das curvas horizontais (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbCritRaio"/>
                        <TextBlock Grid.Row="3" Text="Tangente mínima entre curvas (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbCritTangente"/>
                        <TextBlock Grid.Row="4" Text="Deflexão máxima sem curva (°)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TbCritDeflexao"
                                 ToolTip="Vértice do eixo sem curva com deflexão maior que esta é apontado. Vazio, com raio mínimo informado: qualquer vértice sem curva conta como raio zero."/>
                        <TextBlock Grid.Row="5" Text="Rampa máxima (%)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TbCritRampaMax"/>
                        <TextBlock Grid.Row="6" Text="Rampa mínima (%)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TbCritRampaMin"/>
                        <TextBlock Grid.Row="7" Text="K mínimo – curva convexa (m/%)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TbCritKConvexa"/>
                        <TextBlock Grid.Row="8" Text="K mínimo – curva côncava (m/%)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="TbCritKConcava"/>
                        <TextBlock Grid.Row="9" Text="Comprimento mínimo de curva vertical (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="9" Grid.Column="1" x:Name="TbCritCurvaVert"/>
                        <TextBlock Grid.Row="10" Text="Declividade máxima do terreno (%)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="10" Grid.Column="1" x:Name="TbCritTerreno"
                                 ToolTip="Faces do Toposolid mais íngremes que isto são apontadas no Validar Modelo (V14). Vazio: a declividade do terreno não é conferida."/>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Aparência – janelas">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="As telas grandes (Central do Projeto, Central de Qualidade, Quantitativos, rede de drenagem, terreno, janela da via…) reabrem no tamanho em que foram fechadas. Sem tamanho guardado, abrem no padrão."/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Restaurar o tamanho das janelas" Click="RestaurarJanelasClick" Margin="0"/>
                            <TextBlock x:Name="TxtJanelas" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Documentação – catálogo normativo">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Arquivo JSON com os tipos de marca, dimensões, cores, símbolos, vagas e materiais. Itens com o mesmo código substituem os padrões do plugin."/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Click="BrowseClick"/>
                            <TextBox x:Name="TbCatalog"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Criar cópia editável" Click="CopyClick" Margin="0"/>
                            <Button Content="Abrir pasta" Click="FolderClick"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtCatalogStatus" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        </DockPanel>
        </TabItem>
        <TabItem x:Name="TabProjeto" Header="Do projeto">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelProjeto" Margin="4,6,4,6"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Perfis reutilizáveis">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelPerfis" Margin="4,6,4,6"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Onde fica cada configuração">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelRegistro" Margin="4,6,4,6"/>
            </ScrollViewer>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
