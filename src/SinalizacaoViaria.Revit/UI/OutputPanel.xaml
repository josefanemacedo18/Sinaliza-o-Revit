<UserControl x:Class="SinalizacaoViaria.Revit.UI.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizacaoViaria;component/UI/Styles.xaml"/>
    </UserControl.Resources>
    <GroupBox Header="Representação no Revit">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal">
                <RadioButton x:Name="Rb3D" Content="Modelo 3D (Modelo genérico)" IsChecked="True" Checked="ModeChanged"
                             ToolTip="Sólido fino: aparece em plantas, cortes, 3D, renderizações e tabelas."/>
                <RadioButton x:Name="Rb2D" Content="Detalhe 2D (região preenchida na vista)" Checked="ModeChanged"
                             ToolTip="Regiões preenchidas na vista ativa: ideal para pranchas de sinalização."/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Material" Style="{StaticResource FieldLabel}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbMaterial"/>
            <TextBlock Grid.Row="2" Text="Espessura (m)" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbThickness" ToolTip="Vazio = espessura do material (mínimo modelável definido nas configurações)."/>
            <TextBlock Grid.Row="3" Text="Elevação adicional (m)" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbElevation" ToolTip="Afastamento vertical em relação ao caminho/superfície, evita sobreposição com o pavimento."/>
            <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="CkDrape" Content="Acompanhar a superfície (Toposolid / Piso / Topografia)"
                      ToolTip="Cada peça é posicionada e inclinada conforme a superfície sob ela."/>
            <CheckBox Grid.Row="5" Grid.ColumnSpan="2" x:Name="CkPickSurfaces" Margin="20,2,0,2"
                      IsEnabled="{Binding IsChecked, ElementName=CkDrape}"
                      Content="Selecionar as superfícies após confirmar (senão: qualquer Toposolid/Piso)"/>
        </Grid>
    </GroupBox>
</UserControl>
