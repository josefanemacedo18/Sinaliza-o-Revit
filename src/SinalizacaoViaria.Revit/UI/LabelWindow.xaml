<Window x:Class="SinalizacaoViaria.Revit.UI.LabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anotar sinalização" Width="480" Height="470" MinWidth="420" MinHeight="400">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizaBIM;component/UI/Styles.xaml"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="SvWindow"/>
    </Window.Style>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Anotação com chamada" Style="{StaticResource Title}"/>
            <TextBlock x:Name="TxtHint" Style="{StaticResource Hint}" Text="Depois de confirmar: clique sobre a marca (o ponto clicado recebe a chamada) e em seguida onde o texto deve ficar. Repete até ESC. O texto é lido da própria marca e se atualiza quando ela é editada."/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Altura do texto (mm)" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1" x:Name="TbText" Text="2"/>
            </Grid>
            <CheckBox x:Name="CkName" Content="Código e nome da sinalização" IsChecked="True"/>
            <CheckBox x:Name="CkDetails" Content="Detalhes (largura, padrão, espaçamento, dimensões)" IsChecked="True"/>
            <TextBlock Text="Texto livre (opcional – substitui o automático)" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
            <TextBox x:Name="TbCustom" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnOk" Content="Anotar" Style="{StaticResource Primary}" Click="OkClick" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
