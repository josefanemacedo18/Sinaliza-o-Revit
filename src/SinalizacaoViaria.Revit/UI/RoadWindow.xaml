<Window x:Class="SinalizacaoViaria.Revit.UI.RoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SinalizacaoViaria.Revit.UI"
        Title="Sinalizar via – seção transversal completa" Width="1280" Height="820" MinWidth="980" MinHeight="640">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizaBIM;component/UI/Styles.xaml"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="SvWindow"/>
    </Window.Style>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Seção transversal" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Selecione (ou desenhe) o EIXO da via. Monte cada lado do eixo para fora: faixas, ciclofaixa, estacionamento, canteiros, calçada... O lado direito é o da direita de quem percorre o eixo no sentido em que foi desenhado."/>

                <GroupBox Header="Modelo pronto">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Aplicar" Click="ApplyTemplateClick"/>
                        <ComboBox x:Name="CbTemplate"/>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="Hierarquia viária (CTB art. 60) – obrigatória">
                    <StackPanel>
                        <ComboBox x:Name="CbHierarchy" SelectionChanged="HierarchyChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Gravada em todos os elementos da via (parâmetro SV_Hierarquia) e usada nos quantitativos, na escolha da via preferencial das interseções e na velocidade padrão (CTB art. 61)."/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbTwoWay" Content="Mão dupla" IsChecked="True" Checked="AnyChanged"/>
                    <RadioButton x:Name="RbOneWay" Content="Mão única (todas as faixas no sentido do eixo)" Checked="AnyChanged"/>
                </StackPanel>

                <GroupBox x:Name="GbCenter" Header="Eixo / canteiro central">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Tratamento do eixo" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbCenter" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="1" Text="Canteiro central – largura (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbMedian" Text="2,00" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="2" Text="Tipo de canteiro" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CbMedianType" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="3" Text="Dispositivo no eixo" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CbMedianDevice" SelectionChanged="AnyChanged" ToolTip="Ex.: barreira New Jersey sobre o canteiro, balizadores sobre a LFO."/>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="CkInvertCenter" Content="LFO-4: contínua do lado direito" Checked="AnyChanged" Unchecked="AnyChanged"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Lado direito (do eixo para fora)">
                    <StackPanel>
                        <DataGrid x:Name="GridRight" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" Height="150" SelectionMode="Single" SelectionChanged="GridSelectionChanged" CellEditEnding="CellEdited">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn x:Name="ColTypeRight" Header="Elemento" Width="*" SelectedValueBinding="{Binding Tipo}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                                <DataGridTextColumn Header="Largura (m)" Width="90" Binding="{Binding LarguraTexto}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="+ Adicionar" Tag="R" Click="AddClick" Margin="0"/>
                            <Button Content="Remover" Tag="R" Click="RemoveClick"/>
                            <Button Content="▲" Tag="R" Click="UpClick" MinWidth="32"/>
                            <Button Content="▼" Tag="R" Click="DownClick" MinWidth="32"/>
                            <Button Content="Copiar p/ esquerdo" Tag="R" Click="MirrorClick"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Lado esquerdo (do eixo para fora)">
                    <StackPanel>
                        <DataGrid x:Name="GridLeft" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" Height="150" SelectionMode="Single" SelectionChanged="GridSelectionChanged" CellEditEnding="CellEdited">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn x:Name="ColTypeLeft" Header="Elemento" Width="*" SelectedValueBinding="{Binding Tipo}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                                <DataGridTextColumn Header="Largura (m)" Width="90" Binding="{Binding LarguraTexto}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="+ Adicionar" Tag="L" Click="AddClick" Margin="0"/>
                            <Button Content="Remover" Tag="L" Click="RemoveClick"/>
                            <Button Content="▲" Tag="L" Click="UpClick" MinWidth="32"/>
                            <Button Content="▼" Tag="L" Click="DownClick" MinWidth="32"/>
                            <Button Content="Copiar p/ direito" Tag="L" Click="MirrorClick"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="GbDetails" Header="Elemento selecionado">
                    <StackPanel>
                        <TextBlock x:Name="TxtSelected" Style="{StaticResource Hint}" Text="Selecione um elemento em uma das listas."/>
                        <Grid x:Name="PanelDetails">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="LblVaga" Text="Tipo de vaga" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbVaga" Grid.Column="1" SelectionChanged="DetailChanged"/>
                            <TextBlock x:Name="LblLegenda" Grid.Row="1" Text="Legenda repetida" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbLegenda" Grid.Row="1" Grid.Column="1" TextChanged="DetailChanged" CharacterCasing="Upper" ToolTip="Vazio = sem legenda"/>
                            <TextBlock x:Name="LblEsp" Grid.Row="2" Text="Repetir a cada (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbEspacamento" Grid.Row="2" Grid.Column="1" TextChanged="DetailChanged" ToolTip="0 = sem inscrições"/>
                            <TextBlock x:Name="LblServico" Grid.Row="3" Text="Faixa de serviço c/ meio-fio (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbServico" Grid.Row="3" Grid.Column="1" TextChanged="DetailChanged"/>
                            <TextBlock x:Name="LblAcesso" Grid.Row="4" Text="Faixa de acesso (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbAcesso" Grid.Row="4" Grid.Column="1" TextChanged="DetailChanged"/>
                            <CheckBox x:Name="CkGramado" Grid.Row="5" Grid.ColumnSpan="2" Content="Faixa de serviço gramada" Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <CheckBox x:Name="CkFundo" Grid.Row="6" Grid.ColumnSpan="2" Content="Pintura vermelha de fundo" Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <CheckBox x:Name="CkBidirecional" Grid.Row="7" Grid.ColumnSpan="2" Content="Ciclofaixa bidirecional (sem setas)" Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <TextBlock x:Name="LblDisp" Grid.Row="8" Text="Segregação física (divisa interna)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbDispositivo" Grid.Row="8" Grid.Column="1" SelectionChanged="DetailChanged"/>
                            <TextBlock x:Name="LblSarjeta" Grid.Row="9" Text="Sarjeta junto ao meio-fio (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbSarjeta" Grid.Row="9" Grid.Column="1" TextChanged="DetailChanged" ToolTip="0 = sem sarjeta. Ocupa a borda da pista."/>
                            <TextBlock x:Name="LblCorCaminhada" Grid.Row="10" Text="Cor da faixa de caminhada" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbCorCaminhada" Grid.Row="10" Grid.Column="1" SelectionChanged="DetailChanged"/>
                            <TextBlock x:Name="LblLarguraLinha" Grid.Row="11" Text="Largura da linha de delimitação (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbLarguraLinha" Grid.Row="11" Grid.Column="1" TextChanged="DetailChanged"/>
                            <CheckBox x:Name="CkSeccionada" Grid.Row="12" Grid.ColumnSpan="2" Content="Linha de delimitação seccionada" Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <TextBlock x:Name="LblTraco" Grid.Row="13" Text="Traço / espaço da linha (m)" Style="{StaticResource FieldLabel}"/>
                            <Grid x:Name="PanelTraco" Grid.Row="13" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TbTraco" TextChanged="DetailChanged"/>
                                <TextBox Grid.Column="2" x:Name="TbEspacoLinha" TextChanged="DetailChanged"/>
                            </Grid>
                            <TextBlock x:Name="LblSimbolo" Grid.Row="14" Text="Símbolo bicicleta / seta (m)" Style="{StaticResource FieldLabel}"/>
                            <Grid x:Name="PanelSimbolo" Grid.Row="14" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TbTamSimbolo" TextChanged="DetailChanged" ToolTip="Comprimento do símbolo da bicicleta"/>
                                <TextBox Grid.Column="2" x:Name="TbTamSeta" TextChanged="DetailChanged" ToolTip="Comprimento da seta (0 = sem seta)"/>
                            </Grid>
                            <TextBlock x:Name="LblDistSeta" Grid.Row="15" Text="Distância símbolo → seta (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbDistSeta" Grid.Row="15" Grid.Column="1" TextChanged="DetailChanged"/>
                            <CheckBox x:Name="CkLinhaCentral" Grid.Row="16" Grid.ColumnSpan="2" Content="Linha central amarela (bidirecional)" Checked="DetailChanged" Unchecked="DetailChanged"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Linhas e opções">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Velocidade regulamentada (km/h)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="TbSpeed" Text="60" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="1" Text="Entre faixas de mesmo sentido" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbDivider" SelectionChanged="AnyChanged"/>
                        <CheckBox Grid.Row="2" x:Name="CkEdges" Content="Linhas de bordo" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CbEdge" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="3" Text="Afastamento do bordo (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbEdgeInset" Text="0,10" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="4" Text="Recuo início / fim (m)" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Row="4" Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TbStart" Text="0" TextChanged="AnyChanged"/>
                            <TextBox Grid.Column="2" x:Name="TbEnd" Text="0" TextChanged="AnyChanged"/>
                        </Grid>
                        <CheckBox Grid.Row="5" x:Name="CkStuds" Content="Tachas no eixo" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CbStuds" SelectionChanged="AnyChanged"/>
                        <CheckBox Grid.Row="6" Grid.ColumnSpan="2" x:Name="CkInscriptions" Content="Legendas e símbolos repetidos (ÔNIBUS, bicicletas, setas)" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <CheckBox Grid.Row="7" Grid.ColumnSpan="2" x:Name="CkPhysical" Content="Gerar calçadas, meios-fios e canteiros físicos (3D)" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Pavimento">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Pavimento da pista" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbPavement" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="1" Text="Espessura (m, vazio = padrão)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbPavThickness" TextChanged="AnyChanged" ToolTip="Padrão: asfalto 0,05 m; bloquete 0,08 m; concreto 0,15 m (indicativo – confira o dimensionamento)."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Conexão com as vias existentes">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Onde encontrar outra via" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbConnection" ToolTip="Interseção: usa os tipos e o controle escolhidos na ferramenta Interseção. Rotatória: usa os parâmetros da ferramenta Rotatória."/>
                        <TextBlock Grid.Row="1" Text="Pontas livres da via" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbFreeEnds" ToolTip="Cul-de-sac: usa o tipo e as medidas da ferramenta Cul-de-sac, ajustados à largura da via."/>
                        <TextBlock Grid.Row="2" Text="Raio das esquinas (m, vazio = pela hierarquia)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbCornerRadius" Text="" ToolTip="Vazio: 6 m (local), 8 m (coletora), 10 m (arterial), 15 m (rodovias/trânsito rápido)."/>
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" x:Name="CkIntCrosswalks" Content="Faixas de pedestres e linhas de retenção nas interseções" IsChecked="True"/>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="CkIntRamps" Content="Rebaixamentos de calçada nas travessias (NBR 9050)" IsChecked="True"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Caminho (eixo)">
                    <StackPanel>
                        <RadioButton x:Name="RbDraw" GroupName="path" Content="Desenhar a via por pontos (conecta-se às vias existentes)" IsChecked="True"/>
                        <RadioButton x:Name="RbCurves" GroupName="path" Content="Selecionar linhas existentes"/>
                        <CheckBox x:Name="CkSnap" Content="Encaixar nas pontas e nos eixos das vias existentes" IsChecked="True" Margin="18,3,0,3"
                                  ToolTip="Clique sobre uma via para ligar a nova via ao eixo dela (entroncamento/cruzamento) ou perto da ponta para continuá-la."/>
                        <Grid Margin="18,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Raio das curvas horizontais (m, 0 = cantos vivos)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="TbCurveRadius" Text="30" ToolTip="Concorda os vértices clicados com arcos (reduzido onde não couber)."/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <ui:OutputPanel x:Name="Output"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Pré-visualização (trecho reto de 50 m – eixo em magenta)" Style="{StaticResource Title}"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="TxtSummary" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
                <ui:GeometryPreview x:Name="Preview"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Criar" Style="{StaticResource Primary}" Click="OkClick"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
