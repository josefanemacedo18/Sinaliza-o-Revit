<Window x:Class="SinalizacaoViaria.Revit.UI.RoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SinalizacaoViaria.Revit.UI"
        Title="Via – seção transversal completa a partir do eixo" Width="1280" Height="820" MinWidth="980" MinHeight="640">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizaBIM;component/UI/Styles.xaml"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="SvWindow"/>
    </Window.Style>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Seção transversal" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Desenhe (ou selecione) o EIXO da via. Monte cada lado do eixo para fora: faixas, ciclofaixa, estacionamento, canteiros, calçada... O lado direito é o da direita de quem percorre o eixo no sentido em que foi desenhado. A pista e as conexões são criadas como na ferramenta Pista; calçadas, meios-fios e sarjetas entram em seguida junto ao bordo."/>

                <GroupBox Header="Modelo (prontos e personalizados ★)">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Aplicar" Click="ApplyTemplateClick"/>
                            <ComboBox x:Name="CbTemplate"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Salvar como modelo…" Click="SaveTemplateClick" Margin="0" ToolTip="Guarda a seção atual (faixas, calçadas, linhas, pavimento, hierarquia e conexões) com um nome – fica disponível nas próximas vezes."/>
                            <Button Content="Excluir modelo" Click="DeleteTemplateClick" ToolTip="Exclui o modelo personalizado selecionado (★)."/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Hierarquia viária (CTB art. 60) – obrigatória">
                    <StackPanel>
                        <ComboBox x:Name="CbHierarchy" SelectionChanged="HierarchyChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Gravada em todos os elementos da via (parâmetro SV_Hierarquia) e usada nos quantitativos, na escolha da via preferencial das interseções e na velocidade padrão (CTB art. 61)."/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbTwoWay" Content="Mão dupla" IsChecked="True" Checked="AnyChanged"/>
                    <RadioButton x:Name="RbOneWay" Content="Mão única (todas as faixas no sentido do eixo)" Checked="AnyChanged"/>
                </StackPanel>

                <GroupBox x:Name="GbCenter" Header="Eixo / canteiro central">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Tratamento do eixo" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbCenter" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="1" Text="Canteiro central – largura (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbMedian" Text="2,00" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="2" Text="Tipo de canteiro" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CbMedianType" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="3" Text="Dispositivo no eixo" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CbMedianDevice" SelectionChanged="AnyChanged" ToolTip="Ex.: barreira New Jersey sobre o canteiro, balizadores sobre a LFO."/>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="CkInvertCenter" Content="LFO-4: contínua do lado direito" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <TextBlock Grid.Row="5" Text="Canteiro físico – nível guia / vegetação (m)" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Row="5" Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TbMedianHeight" Text="0,15" TextChanged="AnyChanged" ToolTip="Topo dos meios-fios em relação à pista (0,15 usual)."/>
                            <TextBox Grid.Column="2" x:Name="TbMedianVeg" TextChanged="AnyChanged" ToolTip="Topo da vegetação: vazio = no nível da guia; negativo = canteiro rebaixado (jardim de chuva)."/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Lado direito (do eixo para fora)">
                    <StackPanel>
                        <DataGrid x:Name="GridRight" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" Height="150" SelectionMode="Single" SelectionChanged="GridSelectionChanged" CellEditEnding="CellEdited">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn x:Name="ColTypeRight" Header="Elemento" Width="*" SelectedValueBinding="{Binding Tipo}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                                <DataGridTextColumn Header="Largura (m)" Width="90" Binding="{Binding LarguraTexto}"/>
                                <DataGridTextColumn Header="Nível (m)" Width="70" Binding="{Binding AlturaTexto}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="+ Adicionar" Tag="R" Click="AddClick" Margin="0"/>
                            <Button Content="Remover" Tag="R" Click="RemoveClick"/>
                            <Button Content="▲" Tag="R" Click="UpClick" MinWidth="32"/>
                            <Button Content="▼" Tag="R" Click="DownClick" MinWidth="32"/>
                            <Button Content="Copiar p/ esquerdo" Tag="R" Click="MirrorClick"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Lado esquerdo (do eixo para fora)">
                    <StackPanel>
                        <DataGrid x:Name="GridLeft" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" Height="150" SelectionMode="Single" SelectionChanged="GridSelectionChanged" CellEditEnding="CellEdited">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn x:Name="ColTypeLeft" Header="Elemento" Width="*" SelectedValueBinding="{Binding Tipo}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                                <DataGridTextColumn Header="Largura (m)" Width="90" Binding="{Binding LarguraTexto}"/>
                                <DataGridTextColumn Header="Nível (m)" Width="70" Binding="{Binding AlturaTexto}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="+ Adicionar" Tag="L" Click="AddClick" Margin="0"/>
                            <Button Content="Remover" Tag="L" Click="RemoveClick"/>
                            <Button Content="▲" Tag="L" Click="UpClick" MinWidth="32"/>
                            <Button Content="▼" Tag="L" Click="DownClick" MinWidth="32"/>
                            <Button Content="Copiar p/ direito" Tag="L" Click="MirrorClick"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="GbDetails" Header="Elemento selecionado">
                    <StackPanel>
                        <TextBlock x:Name="TxtSelected" Style="{StaticResource Hint}" Text="Selecione um elemento em uma das listas."/>
                        <Grid x:Name="PanelDetails">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="LblVaga" Text="Tipo de vaga" Style="{StaticResource FieldLabel}"/>
                            <CheckBox x:Name="CkCruzColorido" Grid.Row="24" Grid.ColumnSpan="2" Content="Cruzamentos: pintura colorida entre os quadrados da MCC"
                                      Checked="DetailChanged" Unchecked="DetailChanged"
                                      ToolTip="Nas interseções e acessos a ciclofaixa segue com a marcação de cruzamento rodocicloviário (MCC – MBST Vol. IV). Marque para pintar o piso entre as linhas de quadrados."/>
                            <TextBlock x:Name="LblCorCruz" Grid.Row="25" Text="Cor da pintura do cruzamento" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbCorCruz" Grid.Row="25" Grid.Column="1" SelectionChanged="DetailChanged"/>
                            <TextBlock x:Name="LblZona" Grid.Row="26" Text="Zona de conflito – linha seccionada (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbZona" Grid.Row="26" Grid.Column="1" TextChanged="DetailChanged"
                                     ToolTip="Antes de cada cruzamento em que os veículos convertem cruzando a ciclofaixa, a linha de delimitação fica seccionada neste comprimento (padrão 20 m [a confirmar]; 0 = contínua)."/>
                            <ComboBox x:Name="CbVaga" Grid.Column="1" SelectionChanged="DetailChanged"/>
                            <CheckBox x:Name="CkSoDelimitado" Grid.Row="23" Grid.ColumnSpan="2" Content="Só delimitado: linha tracejada na divisa com a pista, sem divisórias entre vagas"
                                      Checked="DetailChanged" Unchecked="DetailChanged"
                                      ToolTip="Marca delimitadora de estacionamento (MER) só com a linha longitudinal – código, traço e espaço [a confirmar] no MBST Vol. IV. Ajuste largura, traço e espaço abaixo."/>
                            <TextBlock x:Name="LblLegenda" Grid.Row="1" Text="Legenda repetida" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbLegenda" Grid.Row="1" Grid.Column="1" TextChanged="DetailChanged" CharacterCasing="Upper" ToolTip="Vazio = sem legenda"/>
                            <TextBlock x:Name="LblEsp" Grid.Row="2" Text="Repetir a cada (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbEspacamento" Grid.Row="2" Grid.Column="1" TextChanged="DetailChanged" ToolTip="0 = sem inscrições"/>
                            <TextBlock x:Name="LblServico" Grid.Row="3" Text="Faixa de serviço c/ meio-fio (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbServico" Grid.Row="3" Grid.Column="1" TextChanged="DetailChanged"/>
                            <TextBlock x:Name="LblAcesso" Grid.Row="4" Text="Faixa de acesso (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbAcesso" Grid.Row="4" Grid.Column="1" TextChanged="DetailChanged"/>
                            <CheckBox x:Name="CkGramado" Grid.Row="5" Grid.ColumnSpan="2" Content="Faixa de serviço gramada" Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <CheckBox x:Name="CkFundo" Grid.Row="6" Grid.ColumnSpan="2" Content="Pintura vermelha de fundo" Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <CheckBox x:Name="CkFundoOnibus" Grid.Row="6" Grid.ColumnSpan="2" Content="Pintura colorida de fundo (toda a faixa)" ToolTip="Pintura de contraste entre as linhas de bordo da faixa de ônibus – cor escolhida abaixo." Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <CheckBox x:Name="CkBidirecional" Grid.Row="7" Grid.ColumnSpan="2" Content="Ciclofaixa bidirecional (sem setas)" Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <TextBlock x:Name="LblDisp" Grid.Row="8" Text="Segregação física (divisa interna)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbDispositivo" Grid.Row="8" Grid.Column="1" SelectionChanged="DetailChanged"/>
                            <TextBlock x:Name="LblSarjeta" Grid.Row="9" Text="Sarjeta – largura (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbSarjeta" Grid.Row="9" Grid.Column="1" TextChanged="DetailChanged" ToolTip="0 = sem sarjeta. Usual 0,30 a 0,60 m. Com &quot;somar a sarjeta&quot; ela fica entre a última faixa e o meio-fio; senão ocupa a borda da faixa."/>
                            <TextBlock x:Name="LblCorCaminhada" Grid.Row="10" Text="Cor da faixa de caminhada" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbCorCaminhada" Grid.Row="10" Grid.Column="1" SelectionChanged="DetailChanged"/>
                            <TextBlock x:Name="LblCorOnibus" Grid.Row="10" Text="Cor do fundo da faixa de ônibus" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbCorOnibus" Grid.Row="10" Grid.Column="1" SelectionChanged="DetailChanged"/>
                            <TextBlock x:Name="LblLarguraLinha" Grid.Row="11" Text="Largura da linha de delimitação (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbLarguraLinha" Grid.Row="11" Grid.Column="1" TextChanged="DetailChanged"/>
                            <CheckBox x:Name="CkSeccionada" Grid.Row="12" Grid.ColumnSpan="2" Content="Linha de delimitação seccionada" Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <TextBlock x:Name="LblTraco" Grid.Row="13" Text="Traço / espaço da linha (m)" Style="{StaticResource FieldLabel}"/>
                            <Grid x:Name="PanelTraco" Grid.Row="13" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TbTraco" TextChanged="DetailChanged"/>
                                <TextBox Grid.Column="2" x:Name="TbEspacoLinha" TextChanged="DetailChanged"/>
                            </Grid>
                            <TextBlock x:Name="LblSimbolo" Grid.Row="14" Text="Símbolo bicicleta / seta (m)" Style="{StaticResource FieldLabel}"/>
                            <Grid x:Name="PanelSimbolo" Grid.Row="14" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TbTamSimbolo" TextChanged="DetailChanged" ToolTip="Comprimento do símbolo da bicicleta"/>
                                <TextBox Grid.Column="2" x:Name="TbTamSeta" TextChanged="DetailChanged" ToolTip="Comprimento da seta (0 = sem seta)"/>
                            </Grid>
                            <TextBlock x:Name="LblDistSeta" Grid.Row="15" Text="Distância símbolo → seta (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbDistSeta" Grid.Row="15" Grid.Column="1" TextChanged="DetailChanged"/>
                            <CheckBox x:Name="CkLinhaCentral" Grid.Row="16" Grid.ColumnSpan="2" Content="Linha central amarela (bidirecional)" Checked="DetailChanged" Unchecked="DetailChanged"/>
                            <TextBlock x:Name="LblAltura" Grid.Row="17" Text="Nível do topo em relação à pista (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbAltura" Grid.Row="17" Grid.Column="1" TextChanged="DetailChanged"
                                     ToolTip="0,15 = nível de calçada; 0 = nível da pista; negativo = rebaixado (só calçada e canteiro). Faixas acima de 0 viram plataforma elevada com meio-fio no degrau."/>
                            <TextBlock x:Name="LblMeioFio" Grid.Row="19" Text="Meio-fio – largura no topo (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbMeioFio" Grid.Row="19" Grid.Column="1" TextChanged="DetailChanged"
                                     ToolTip="Guia de concreto: 0,12 a 0,15 m usual (padrão 0,15). A altura do meio-fio (espelho) é o nível da calçada acima."/>
                            <TextBlock x:Name="LblInclinacao" Grid.Row="20" Text="Inclinação transversal (%, sobe p/ o lote)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbInclinacao" Grid.Row="20" Grid.Column="1" TextChanged="DetailChanged"
                                     ToolTip="NBR 9050: até 3 %. 0 = calçada plana. A calçada sobe do meio-fio em direção ao alinhamento."/>
                            <TextBlock x:Name="LblNiveis" Grid.Row="21" Text="Nível no alinhamento (estaca:nível; …)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbNiveis" Grid.Row="21" Grid.Column="1" TextChanged="DetailChanged"
                                     ToolTip="Ex.: 0:0,15; 40:0,45; 70:0,45; 90:0,15 – nível (m acima da pista) junto ao lote em cada estaca, para edificações mais altas ou topografia. A faixa de acesso vence o desnível (rampa ≤ 8,33 %; acima disso, avisa para prever degraus)."/>
                            <TextBlock x:Name="LblNiveisHint" Grid.Row="22" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                                       Text="Use a faixa de acesso (junto ao lote) para absorver desníveis: a faixa livre mantém a inclinação de até 3 % e a de acesso vira rampa."/>
                            <TextBlock x:Name="LblVegetacao" Grid.Row="18" Text="Nível da vegetação (m, vazio = igual)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbVegetacao" Grid.Row="18" Grid.Column="1" TextChanged="DetailChanged"
                                     ToolTip="Faixa gramada da calçada ou vegetação do canteiro: mais alta (floreira), no nível ou rebaixada (jardim de chuva)."/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Linhas e opções">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Velocidade regulamentada (km/h)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="TbSpeed" Text="60" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="1" Text="Entre faixas de mesmo sentido" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbDivider" SelectionChanged="AnyChanged"/>
                        <CheckBox Grid.Row="2" x:Name="CkEdges" Content="Linhas de bordo" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CbEdge" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="3" Text="Afastamento do bordo (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbEdgeInset" Text="0,10" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="4" Text="Recuo início / fim (m)" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Row="4" Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TbStart" Text="0" TextChanged="AnyChanged"/>
                            <TextBox Grid.Column="2" x:Name="TbEnd" Text="0" TextChanged="AnyChanged"/>
                        </Grid>
                        <CheckBox Grid.Row="5" x:Name="CkStuds" Content="Tachas no eixo" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CbStuds" SelectionChanged="AnyChanged"/>
                        <CheckBox Grid.Row="6" Grid.ColumnSpan="2" x:Name="CkInscriptions" Content="Legendas e símbolos repetidos (ÔNIBUS, bicicletas, setas)" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <CheckBox Grid.Row="7" Grid.ColumnSpan="2" x:Name="CkPhysical" Content="Gerar calçadas, meios-fios e canteiros físicos (3D)" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <CheckBox Grid.Row="8" Grid.ColumnSpan="2" x:Name="CkGutterAdds" Content="Somar a sarjeta à largura da pista (as faixas mantêm a largura útil)" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"
                                  ToolTip="Marcado: pista entre meios-fios = faixas + sarjetas (ex.: 3,50 + 0,30 = 3,80 m até a face da guia). Desmarcado: a sarjeta ocupa a borda da última faixa (vias criadas antes desta versão)."/>
                        <CheckBox Grid.Row="9" Grid.ColumnSpan="2" x:Name="CkTactile" Content="Piso tátil nas calçadas (faixa direcional ligada às rampas)" Checked="AnyChanged" Unchecked="AnyChanged"
                                  ToolTip="Faixa direcional no meio da faixa livre de cada calçada, ligada a cada rampa por um ramal perpendicular, com alerta no topo da rampa e nas junções (NBR 16537). Acompanha a via quando ela é editada."/>
                        <CheckBox Grid.Row="10" Grid.ColumnSpan="2" x:Name="CkArrows" Content="Mão única: setas de sentido no meio de cada faixa" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"
                                  ToolTip="Seta &quot;siga em frente&quot; (PEM-F) repetida a cada 50 m (espaçamento [a confirmar] no MBST Vol. IV) em cada faixa de rolamento, no sentido do eixo. Precisa das legendas e símbolos ligados."/>
                        <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="Sinalização vertical automática (refeita ao editar a via; o que for editado à mão fica):" Style="{StaticResource FieldLabel}"/>
                        <CheckBox Grid.Row="12" Grid.ColumnSpan="2" x:Name="CkAutoSpeed" Content="R-19 – velocidade máxima da via no início de cada sentido" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"
                                  ToolTip="Legenda = velocidade regulamentada (pela hierarquia – CTB art. 61). A 20 m do início de cada sentido, na calçada à direita de quem trafega (posição [a confirmar] no MBST Vol. I)."/>
                        <CheckBox Grid.Row="13" Grid.ColumnSpan="2" x:Name="CkAutoOneWay" Content="R-24a – sentido de circulação (vias de mão única)" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <CheckBox Grid.Row="14" Grid.ColumnSpan="2" x:Name="CkAutoCrossing" Content="A-32b – passagem sinalizada de pedestres nas travessias da via (antecipada e na travessia)" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"
                                  ToolTip="Nas travessias no meio da quadra (extensões de calçada e canteiro). R-1/R-2, retenção e legenda das aproximações controladas vêm da interseção."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Largura variável ao longo do eixo (levantamento)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Medidas do levantamento em cada estaca: distância do EIXO ao bordo da pista (face do meio-fio/sarjeta) e ao alinhamento (muro, divisa do lote). Vazio = medida da seção. Entre as estacas a largura varia gradualmente; antes do primeiro e depois do último ponto fica constante. Estaca em metros (110) ou em estacas de 20 m (5+10)."/>
                        <DataGrid x:Name="GridWidths" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" Height="130" SelectionMode="Single" CellEditEnding="CellEdited">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Estaca" Width="70" Binding="{Binding Estaca}"/>
                                <DataGridTextColumn Header="Bordo esq." Width="*" Binding="{Binding BordoEsq}"/>
                                <DataGridTextColumn Header="Bordo dir." Width="*" Binding="{Binding BordoDir}"/>
                                <DataGridTextColumn Header="Alinh. esq." Width="*" Binding="{Binding AlinhEsq}"/>
                                <DataGridTextColumn Header="Alinh. dir." Width="*" Binding="{Binding AlinhDir}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="+ Ponto" Click="AddWidthClick" Margin="0"/>
                            <Button Content="Remover" Click="RemoveWidthClick"/>
                            <Button Content="Limpar" Click="ClearWidthsClick"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Mudar a largura de um elemento num trecho (calçada, pista, estacionamento ou canteiro), do início (A) ao fim (B), com transição em cada ponta:"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="Alterar largura por trecho (A–B)…" Click="AddStretchClick" Margin="0"
                                    ToolTip="Mesma janela da ferramenta Alterar Largura por Trecho (na planta, os pontos A e B são clicados no eixo)."/>
                            <Button Content="Remover trechos" Click="ClearStretchesClick"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtStretches" Style="{StaticResource Hint}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Quem absorve a variação na pista" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" x:Name="CbAbsorb" SelectionChanged="AnyChanged"/>
                        </Grid>
                        <CheckBox x:Name="CkSmoothWidth" Content="Transição em curva S (suave) entre os pontos" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <CheckBox x:Name="CkReadSurvey" Content="Depois de indicar o eixo, ler do desenho os meios-fios e muros existentes (linhas do levantamento)"
                                  ToolTip="Após o eixo, selecione as linhas do bordo direito, bordo esquerdo, alinhamento direito e esquerdo (ESC pula). O plugin mede a distância ao eixo a cada 5 m e preenche esta tabela."/>
                        <TextBlock x:Name="TxtNominal" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Recuos do meio-fio: baias de ônibus, faixas de aceleração/desaceleração">
                    <StackPanel>
                        <DataGrid x:Name="GridRecess" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" Height="110" SelectionMode="Single" CellEditEnding="CellEdited">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tipo" Width="*" Binding="{Binding TipoTexto}" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="Esq." Width="36" Binding="{Binding Esquerdo, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Estaca" Width="55" Binding="{Binding Estaca}"/>
                                <DataGridTextColumn Header="Compr." Width="50" Binding="{Binding Comprimento}"/>
                                <DataGridTextColumn Header="Prof." Width="45" Binding="{Binding Profundidade}"/>
                                <DataGridTextColumn Header="Taper in" Width="55" Binding="{Binding TaperIn}"/>
                                <DataGridTextColumn Header="Taper out" Width="60" Binding="{Binding TaperOut}"/>
                                <DataGridCheckBoxColumn Header="Calçada recua" Width="55" Binding="{Binding CalcadaRecua, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridCheckBoxColumn Header="Curva S" Width="45" Binding="{Binding Curva, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox x:Name="CbRecessType" Width="210" Margin="0,0,0,0"/>
                            <Button Content="+ Adicionar" Click="AddRecessClick"/>
                            <Button Content="Remover" Click="RemoveRecessClick"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Estaca = início da transição de entrada; comprimento = trecho com a profundidade total. Os valores iniciais seguem a velocidade da via (DNIT/AASHTO, indicativos). Baia: MVE amarela, ÔNIBUS, LCO na boca, placa e abrigo. Faixas auxiliares: LCO e setas. Calçada recua = o alinhamento fica e a calçada estreita."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Pavimento">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Pavimento da pista" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbPavement" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="1" Text="Espessura (m, vazio = padrão)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbPavThickness" TextChanged="AnyChanged" ToolTip="Padrão: asfalto 0,05 m; bloquete 0,08 m; concreto 0,15 m (indicativo – confira o dimensionamento)."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Conexão com as vias existentes">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Onde encontrar outra via" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbConnection" ToolTip="Interseção: usa os tipos e o controle escolhidos na ferramenta Interseção. Rotatória: usa os parâmetros da ferramenta Rotatória."/>
                        <TextBlock Grid.Row="1" Text="Pontas livres da via" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbFreeEnds" ToolTip="Cul-de-sac: usa o tipo e as medidas da ferramenta Cul-de-sac, ajustados à largura da via."/>
                        <TextBlock Grid.Row="2" Text="Raio de concordância das esquinas / guia (m, vazio = pela hierarquia)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbCornerRadius" Text="" ToolTip="Vazio: 6 m (local), 8 m (coletora), 10 m (arterial), 15 m (rodovias/trânsito rápido)."/>
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" x:Name="CkIntCrosswalks" Content="Faixas de pedestres nas interseções (a retenção e o PARE são sempre criados)" IsChecked="False"/>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="CkIntRamps" Content="Rebaixamentos de calçada nas travessias (NBR 9050)" IsChecked="False"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Relevo sobre o terreno nativo (Massa e terreno → Toposolid)">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Greide da via" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbRelief" ToolTip="Acompanhar o terreno: a via sobe e desce com a topografia e o Toposolid é cortado/aterrado só na largura da plataforma. Greide suavizado: rampa máxima e curvas verticais, com cortes e aterros maiores (taludes). Plana: sem alterar o terreno."/>
                        <TextBlock Grid.Row="1" Text="Rampa máxima (%) – greide suavizado" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbReliefGrade" Text="8" ToolTip="Vias urbanas: até 8–10 %; rodovias (DNIT): 3–6 %."/>
                        <TextBlock Grid.Row="2" Text="Talude de corte (H : 1 V)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbCutSlope" Text="1"/>
                        <TextBlock Grid.Row="3" Text="Talude de aterro (H : 1 V)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbFillSlope" Text="1,5"/>
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"
                                   Text="Com Toposolid sob a via, o terreno é cortado e aterrado automaticamente (taludes, degraus nos muros). Sem Toposolid a via fica plana. Depois, Perfil da Via ajusta o greide e cria viadutos/túneis onde o relevo pede."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Caminho (eixo)">
                    <StackPanel>
                        <RadioButton x:Name="RbDraw" GroupName="path" Content="Desenhar a via por pontos (conecta-se às vias existentes)" IsChecked="True"/>
                        <RadioButton x:Name="RbCurves" GroupName="path" Content="Selecionar linhas existentes"/>
                        <RadioButton x:Name="RbFloors" GroupName="path" Content="Reconhecer em pisos existentes (eixo e largura do contorno do piso)"
                                     ToolTip="Para pistas modeladas com Piso comum (projetos antigos, formas complexas): selecione os pisos e o plugin acha os eixos, as larguras e os encontros. Use o pavimento &quot;Nenhum (pista já modelada)&quot; para não duplicar o piso."/>
                        <CheckBox x:Name="CkSnap" Content="Encaixar nas pontas e nos eixos das vias existentes" IsChecked="True" Margin="18,3,0,3"
                                  ToolTip="Clique sobre uma via para ligar a nova via ao eixo dela (entroncamento/cruzamento) ou perto da ponta para continuá-la."/>
                        <Grid Margin="18,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Raio das curvas do eixo (m, mín. = meia largura + 1,5)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="TbCurveRadius" Text="30" ToolTip="Raio das curvas do eixo: concorda os vértices clicados e arredonda os cantos vivos das linhas selecionadas (nunca menor que a meia largura + 1,5 m, para a borda interna também fazer curva)."/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <ui:OutputPanel x:Name="Output"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Pré-visualização (trecho reto de 50 m – eixo em magenta)" Style="{StaticResource Title}"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="TxtSummary" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="#F4F7FB" Padding="8,6" Margin="0,6,0,0">
                <TextBlock x:Name="TxtWidths" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
            </Border>
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
                <ui:GeometryPreview x:Name="Preview"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnOk" Content="Criar" Style="{StaticResource Primary}" Click="OkClick"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
