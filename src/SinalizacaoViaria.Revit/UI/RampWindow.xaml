<Window x:Class="SinalizacaoViaria.Revit.UI.RampWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SinalizacaoViaria.Revit.UI"
        Title="Rampas e rebaixamentos de calçada" Width="980" Height="660" MinWidth="820" MinHeight="540">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizaBIM;component/UI/Styles.xaml"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="SvWindow"/>
    </Window.Style>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Rampa" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Hint}" Text="1º clique: centro da rampa na FACE DO MEIO-FIO (divisa com a pista). 2º clique: um ponto para dentro da calçada (sentido da subida). Repete até ESC."/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="6" Text="Comprimento da rampa (m)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TbLength" TextChanged="AnyChanged" ToolTip="Vazio = calculado pela inclinação. Informado: a inclinação passa a ser desnível ÷ comprimento."/>
                    <TextBlock Grid.Row="7" Text="Comprimento das abas (m)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="TbFlareLength" TextChanged="AnyChanged" ToolTip="Vazio = calculado pela inclinação das abas."/>
                    <TextBlock Grid.Row="8" Text="Desnível no meio-fio (m)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="TbLip" Text="0" TextChanged="AnyChanged" ToolTip="Degrau residual entre a pista e o início da rampa (NBR 9050: até 5 mm)."/>
                    <TextBlock Grid.Row="9" Text="Patamar no topo (m)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="9" Grid.Column="1" x:Name="TbLanding" Text="0" TextChanged="AnyChanged" ToolTip="Faixa plana no nível da calçada logo após a rampa (0 = sem patamar)."/>
                    <TextBlock Grid.Row="10" Text="Material" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Row="10" Grid.Column="1" x:Name="CbRampColor" SelectionChanged="AnyChanged"/>
                    <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1" x:Name="CbType" SelectionChanged="TypeChanged"/>
                    <TextBlock Grid.Row="1" Text="Largura (m)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbWidth" TextChanged="AnyChanged"/>
                    <TextBlock Grid.Row="2" Text="Altura do meio-fio (m)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbHeight" Text="0,15" TextChanged="AnyChanged"/>
                    <TextBlock Grid.Row="3" Text="Inclinação da rampa (%)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbSlope" TextChanged="AnyChanged"/>
                    <TextBlock Grid.Row="4" Text="Inclinação das abas (%)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TbFlare" Text="10" TextChanged="AnyChanged"/>
                    <TextBlock Grid.Row="5" Text="Profundidade da calçada rebaixada (m)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="TbDepth" Text="1,80" TextChanged="AnyChanged"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="Rebaixamento total: toda a largura da calçada é rebaixada ao nível da faixa de travessia, com rampas laterais (uso quando a calçada é estreita). A profundidade só vale para este tipo."/>
                <GroupBox Header="Piso tátil de alerta (NBR 16537)">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="5" Text="Comprimento ao longo do meio-fio (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TbTactileLength" TextChanged="AnyChanged" ToolTip="Vazio = largura toda da rampa."/>
                        <TextBlock Grid.Row="6" Text="Largura do direcional (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TbDirWidth" Text="0,25" TextChanged="AnyChanged"/>
                        <CheckBox Grid.ColumnSpan="2" x:Name="CkTactile" Content="Incluir piso tátil de alerta junto à pista" IsChecked="True" Checked="AnyChanged" Unchecked="AnyChanged"/>
                        <TextBlock Grid.Row="1" Text="Largura (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbTactile" Text="0,40" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="2" Text="Cor" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CbTactileColor" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="3" Text="Afastamento do meio-fio (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbSetback" Text="0" TextChanged="AnyChanged"/>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="CkDirectional" Content="Piso tátil direcional no eixo da rampa" Checked="AnyChanged" Unchecked="AnyChanged"/>
                    </Grid>
                </GroupBox>
                <CheckBox x:Name="CkCut" Content="Recortar calçada, meio-fio e grama existentes sob a rampa" IsChecked="True"/>
                <ui:OutputPanel x:Name="Output"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Pré-visualização (pista embaixo, calçada em cima)" Style="{StaticResource Title}"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="TxtWarnings" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
                <ui:GeometryPreview x:Name="Preview"/>
            </Border>
        </DockPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnOk" Content="Inserir" Style="{StaticResource Primary}" Click="OkClick" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
