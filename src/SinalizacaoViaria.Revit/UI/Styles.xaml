<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================================================================ Tokens (Etapa 9; os mesmos de UiTokens.cs)
         Cor nunca é o único sinal de um estado: o texto diz o estado (aviso, erro, desatualizado). -->
    <!-- superfícies e texto -->
    <SolidColorBrush x:Key="Panel" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AltRow" Color="#FAFBFD"/>
    <SolidColorBrush x:Key="Text" Color="#1B2330"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5F6B7A"/>
    <SolidColorBrush x:Key="Muted" Color="#5F6B7A"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentMuted" Color="#CFE0F5"/>
    <SolidColorBrush x:Key="Disabled" Color="#8893A2"/>
    <!-- primária e seleção -->
    <SolidColorBrush x:Key="Accent" Color="#1F5FA8"/>
    <SolidColorBrush x:Key="AccentDark" Color="#174A83"/>
    <SolidColorBrush x:Key="Selection" Color="#CFE0F5"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#E8EFF8"/>
    <!-- bordas -->
    <SolidColorBrush x:Key="Border" Color="#D5DBE3"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#E6EAF0"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#8893A2"/>
    <!-- estados -->
    <SolidColorBrush x:Key="Success" Color="#2E7D32"/>
    <SolidColorBrush x:Key="SuccessBackground" Color="#EAF4EA"/>
    <SolidColorBrush x:Key="Warning" Color="#8F5D00"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#FFF4DD"/>
    <SolidColorBrush x:Key="Warn" Color="#8F5D00"/>
    <SolidColorBrush x:Key="Error" Color="#B3261E"/>
    <SolidColorBrush x:Key="ErrorBackground" Color="#FCEBEA"/>
    <!-- desenho -->
    <SolidColorBrush x:Key="Asphalt" Color="#3E4248"/>

    <!-- espaçamento (escala de 4) -->
    <Thickness x:Key="SpaceS">4</Thickness>
    <Thickness x:Key="SpaceM">8</Thickness>
    <Thickness x:Key="SpaceL">12</Thickness>
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="SectionMargin">0,12,0,4</Thickness>

    <!-- ================================================================ Foco perceptível (teclado) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="1.5" Stroke="{StaticResource Accent}" StrokeDashArray="2 1" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Janela e tipografia -->
    <Style TargetType="Window" x:Key="SvWindow">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
    </Style>

    <!-- Título da janela -->
    <Style TargetType="TextBlock" x:Key="Title">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <!-- Título de seção -->
    <Style TargetType="TextBlock" x:Key="SectionTitle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
        <Setter Property="Margin" Value="{StaticResource SectionMargin}"/>
    </Style>
    <!-- Subtítulo -->
    <Style TargetType="TextBlock" x:Key="Subtitle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="0,4,0,2"/>
    </Style>
    <!-- Texto auxiliar -->
    <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,6"/>
    </Style>
    <!-- Legenda / informação de status pequena -->
    <Style TargetType="TextBlock" x:Key="Caption">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="FieldLabel">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,3,8,3"/>
        <Setter Property="MaxWidth" Value="260"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Valor de engenharia: algarismos de largura fixa, alinhados na coluna -->
    <Style TargetType="TextBlock" x:Key="Value">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="ValueLarge" BasedOn="{StaticResource Value}">
        <Setter Property="FontSize" Value="19"/>
    </Style>
    <!-- Mensagem de validação junto ao campo -->
    <Style TargetType="TextBlock" x:Key="ValidationText">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Error}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ================================================================ Estados (o texto diz o estado) -->
    <Style TargetType="TextBlock" x:Key="StatusOk">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Success}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="StatusWarning">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="StatusError">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Error}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="StatusInfo">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="StatusUnknown">
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <!-- ================================================================ Contêineres -->
    <!-- Cartão: superfície branca com borda -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <!-- Faixas de mensagem (informação, aviso, erro, sucesso) -->
    <Style TargetType="Border" x:Key="BannerInfo">
        <Setter Property="Background" Value="{StaticResource SelectionBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Selection}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style TargetType="Border" x:Key="BannerWarning" BasedOn="{StaticResource BannerInfo}">
        <Setter Property="Background" Value="{StaticResource WarningBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Warning}"/>
    </Style>
    <Style TargetType="Border" x:Key="BannerError" BasedOn="{StaticResource BannerInfo}">
        <Setter Property="Background" Value="{StaticResource ErrorBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Error}"/>
    </Style>
    <Style TargetType="Border" x:Key="BannerSuccess" BasedOn="{StaticResource BannerInfo}">
        <Setter Property="Background" Value="{StaticResource SuccessBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
    </Style>

    <!-- ================================================================ Campos -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="3,2"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="0,3,12,3"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,4,0,6"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>

    <!-- ================================================================ Botões -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Ação principal da janela -->
    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Ação secundária -->
    <Style TargetType="Button" x:Key="Secondary" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>
    <!-- Ação que apaga ou substitui (sempre com rótulo que diz o que faz) -->
    <Style TargetType="Button" x:Key="Danger" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Error}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Error}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ================================================================ Listas, tabelas, progresso, dicas -->
    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource AltRow}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Background" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="Height" Value="8"/>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <!-- Dicas longas quebram linha em vez de atravessar a tela -->
    <Style TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="440"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
