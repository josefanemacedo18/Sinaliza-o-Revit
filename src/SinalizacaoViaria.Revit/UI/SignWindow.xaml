<Window x:Class="SinalizacaoViaria.Revit.UI.SignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SinalizacaoViaria.Revit.UI"
        Title="Sinalização vertical – placas" Width="1100" Height="700" MinWidth="900" MinHeight="580">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizaBIM;component/UI/Styles.xaml"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="SvWindow"/>
    </Window.Style>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Placa" Style="{StaticResource Title}"/>
            <ComboBox DockPanel.Dock="Top" x:Name="CbCategory" SelectionChanged="CategoryChanged"/>
            <TextBox DockPanel.Dock="Top" x:Name="TbSearch" Margin="0,4,0,0" TextChanged="SearchChanged" ToolTip="Pesquisar por código ou nome (ex.: R-6, bicicleta, curva)"/>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="8" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock x:Name="TxtDescription" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtReference" Style="{StaticResource Hint}" FontStyle="Italic"/>
                </StackPanel>
            </Border>
            <ListBox x:Name="LbTypes" SelectionChanged="TypeChanged" Margin="0,4,0,0" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="40" Height="40" Margin="0,1,8,1" Source="{Binding Converter={x:Static ui:SignThumbConverter.Instance}}"/>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Parâmetros" Style="{StaticResource Title}"/>
                <GroupBox Header="Chapa">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Largura / diâmetro / lado (m)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbSize" IsEditable="True" SelectionChanged="AnyChanged" LostFocus="AnyChanged"/>
                        <TextBlock Grid.Row="1" Text="Altura – retangulares (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbHeight" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="2" Text="Legenda" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbLegend" TextChanged="AnyChanged" CharacterCasing="Upper" ToolTip="Vazio = legenda do catálogo; '-' = sem legenda. Ex.: velocidade da R-19."/>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Suporte">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Tipo de suporte" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="CbSupport" SelectionChanged="AnyChanged"/>
                        <TextBlock Grid.Row="1" Text="Altura livre sob a placa (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbMount" Text="2,10" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="2" Text="Diâmetro da coluna (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbPost" Text="0,063" TextChanged="AnyChanged"/>
                        <TextBlock Grid.Row="3" Text="Deslocamento da placa (m)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbLateral" Text="0" TextChanged="AnyChanged" ToolTip="+ à direita do condutor"/>
                    </Grid>
                </GroupBox>
                <GroupBox x:Name="GbPlacement" Header="Inserção">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="1º clique: posição do suporte (na calçada). 2º clique: SENTIDO do tráfego que deve ler a placa – a face fica voltada para quem se aproxima."/>
                        <RadioButton x:Name="RbTwoClicks" GroupName="place" Content="Suporte + sentido (2 cliques, repete até ESC)" IsChecked="True"/>
                        <RadioButton x:Name="RbAngle" GroupName="place" Content="Suporte + ângulo fixo"/>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <TextBlock Text="Ângulo do tráfego (°)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbAngle" Text="0" Width="60"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <ui:OutputPanel x:Name="Output"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Vista frontal (como o condutor vê)" Style="{StaticResource Title}"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="TxtWarnings" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
                <ui:GeometryPreview x:Name="Preview"/>
            </Border>
        </DockPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnOk" Content="Inserir" Style="{StaticResource Primary}" Click="OkClick" IsDefault="True"/>
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
