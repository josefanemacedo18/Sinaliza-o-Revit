<Window x:Class="SinalizacaoViaria.Revit.UI.QuantitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SinalizacaoViaria.Revit.UI"
        Title="Quantitativos – SinalizaBIM" Width="1320" Height="820" MinWidth="900" MinHeight="560">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizaBIM;component/UI/Styles.xaml"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="SvWindow"/>
    </Window.Style>
    <DockPanel Margin="12">
        <!-- Cabeçalho -->
        <Border DockPanel.Dock="Top" Background="#1F5FA8" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="QUANTITATIVO DE SINALIZAÇÃO VIÁRIA E URBANIZAÇÃO" Foreground="#CFE0F5" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtProject" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtHeader" Foreground="#E3ECF7" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Indicadores -->
        <ItemsControl DockPanel.Dock="Top" x:Name="Kpis" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="#D5DBE3" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="10,6">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding Accent}" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="#5F6B7A" FontSize="11"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="SemiBold" Foreground="#1B2330"/>
                                    <TextBlock Text="{Binding Unit}" FontSize="12" Foreground="#5F6B7A" Margin="4,0,0,2" VerticalAlignment="Bottom"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Filtros -->
        <Border DockPanel.Dock="Top" Background="#F4F6F9" BorderBrush="#D5DBE3" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CbCategory" Width="290" SelectionChanged="FilterChanged"/>
                <TextBlock Text="Hierarquia" Style="{StaticResource FieldLabel}" Margin="14,3,8,3"/>
                <ComboBox x:Name="CbHierarchy" Width="200" SelectionChanged="FilterChanged"/>
                <Button DockPanel.Dock="Right" Content="Recolher grupos" Click="CollapseClick" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Expandir grupos" Click="ExpandClick" Margin="6,0,0,0"/>
                <TextBlock Text="Pesquisar" Style="{StaticResource FieldLabel}" Margin="14,3,8,3"/>
                <TextBox x:Name="TbSearch" TextChanged="FilterChanged" ToolTip="Código, descrição, subcategoria, cor, material ou família"/>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" VerticalAlignment="Center" MaxWidth="560" TextWrapping="Wrap"
                       Text="Área pintada para tintas; área em planta para concreto, grama e demais elementos físicos. Consumos estimados pelo catálogo de materiais. Clique numa linha para ver referência e detalhes."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Exportar CSV (Excel)" Click="ExportClick" ToolTip="Exporta a seleção atual, separada por categoria e subcategoria, com subtotais e resumos."/>
                <Button Content="Criar tabela no Revit" Click="ScheduleClick" ToolTip="Tabela 'SV - Quantitativos' agrupada por categoria, hierarquia e subcategoria, com subtotais (parâmetros SV_*)."/>
                <Button Content="Tabelas por categoria" Click="SchedulesByCategoryClick" ToolTip="Cria uma tabela do Revit para cada categoria existente no projeto."/>
                <Button Content="Fechar" IsCancel="True" Style="{StaticResource Primary}"/>
            </StackPanel>
        </DockPanel>

        <TabControl>
            <TabItem Header="Itens detalhados">
                <DataGrid x:Name="GridRows" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6EAF0" AlternatingRowBackground="#FAFBFD" RowHeight="26"
                          RowDetailsVisibilityMode="VisibleWhenSelected" SelectionMode="Single" BorderBrush="#D5DBE3">
                    <DataGrid.GroupStyle>
                        <!-- Nível 1: categoria -->
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Margin="0,6,0,0" Tag="group">
                                                    <Expander.Header>
                                                        <DockPanel Background="#E8EFF8" MinWidth="700">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#174A83" Margin="6,4"/>
                                                            <TextBlock Text="{Binding Converter={x:Static ui:GroupSummaryConverter.Instance}}" Foreground="#174A83" Margin="12,4" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                        <!-- Nível 2: subcategoria -->
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Margin="16,2,0,0" Tag="group">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#2B3A4E" Margin="2,2"/>
                                                            <TextBlock Text="{Binding Converter={x:Static ui:GroupSummaryConverter.Instance}}" Foreground="#5F6B7A" Margin="10,2"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Cor" Width="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="14" Height="14" CornerRadius="3" BorderBrush="#8893A2" BorderThickness="1" Margin="4,0,6,0"
                                                Background="{Binding Color, Converter={x:Static ui:MarkingColorBrushConverter.Instance}}"/>
                                        <TextBlock Text="{Binding ColorLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="95" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Quantidade" Binding="{Binding MainQuantity, StringFormat=N2, ConverterCulture=pt-BR}" Width="92" FontWeight="SemiBold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Un." Binding="{Binding Unit}" Width="40"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area, StringFormat=N2, ConverterCulture=pt-BR}" Width="82">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Extensão (m)" Binding="{Binding PaintedLength, StringFormat=N2, ConverterCulture=pt-BR}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Unid." Binding="{Binding Units}" Width="52">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Hierarquia" Binding="{Binding HierarchyName}" Width="120"/>
                        <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="140"/>
                        <DataGridTextColumn Header="Consumo" Binding="{Binding ConsumptionText}" Width="100"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#F4F6F9" BorderBrush="#D5DBE3" BorderThickness="0,1,0,1" Padding="104,6,8,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Foreground="#2B3A4E"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </TabItem>
            <TabItem Header="Resumo por categoria e subcategoria">
                <DataGrid x:Name="GridCategories" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6EAF0" RowHeight="26" BorderBrush="#D5DBE3">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Code}" Value="SUBTOTAL">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Background" Value="#E8EFF8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Categoria / subcategoria" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Itens" Binding="{Binding Elements}" Width="70"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area, StringFormat=N2, ConverterCulture=pt-BR}" Width="110"/>
                        <DataGridTextColumn Header="Extensão (m)" Binding="{Binding PaintedLength, StringFormat=N2, ConverterCulture=pt-BR}" Width="110"/>
                        <DataGridTextColumn Header="Unidades" Binding="{Binding Units}" Width="90"/>
                        <DataGridTextColumn Header="Consumo de tinta" Binding="{Binding MaterialConsumption, StringFormat=N2, ConverterCulture=pt-BR}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Resumo por hierarquia viária">
                <DataGrid x:Name="GridHierarchy" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6EAF0" RowHeight="26" BorderBrush="#D5DBE3">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hierarquia (CTB art. 60)" Binding="{Binding Name}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Extensão de vias (m)" Binding="{Binding RoadLength, StringFormat=N2, ConverterCulture=pt-BR}" Width="130"/>
                        <DataGridTextColumn Header="Pavimento (m²)" Binding="{Binding PavementArea, StringFormat=N2, ConverterCulture=pt-BR}" Width="110"/>
                        <DataGridTextColumn Header="Área pintada (m²)" Binding="{Binding PaintedArea, StringFormat=N2, ConverterCulture=pt-BR}" Width="120"/>
                        <DataGridTextColumn Header="Extensão pintada (m)" Binding="{Binding PaintedLength, StringFormat=N2, ConverterCulture=pt-BR}" Width="130"/>
                        <DataGridTextColumn Header="Placas" Binding="{Binding Signs}" Width="70"/>
                        <DataGridTextColumn Header="Elementos" Binding="{Binding Elements}" Width="80"/>
                        <DataGridTextColumn Header="Consumo de tinta" Binding="{Binding PaintConsumption, StringFormat=N2, ConverterCulture=pt-BR}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Pintura por cor e material">
                <DataGrid x:Name="GridSummary" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6EAF0" RowHeight="26" BorderBrush="#D5DBE3">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Cor" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="14" Height="14" CornerRadius="3" BorderBrush="#8893A2" BorderThickness="1" Margin="4,0,6,0"
                                                Background="{Binding Color, Converter={x:Static ui:MarkingColorBrushConverter.Instance}}"/>
                                        <TextBlock Text="{Binding ColorLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area, StringFormat=N2, ConverterCulture=pt-BR}" Width="100"/>
                        <DataGridTextColumn Header="Consumo" Binding="{Binding MaterialConsumption, StringFormat=N2, ConverterCulture=pt-BR}" Width="100"/>
                        <DataGridTextColumn Header="Un." Binding="{Binding ConsumptionUnit}" Width="60"/>
                        <DataGridTextColumn Header="Microesferas (kg)" Binding="{Binding GlassBeadsKg, StringFormat=N2, ConverterCulture=pt-BR}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
