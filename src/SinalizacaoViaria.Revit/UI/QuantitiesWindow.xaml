<Window x:Class="SinalizacaoViaria.Revit.UI.QuantitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quantitativos – SinalizaBIM" Width="1240" Height="760" MinWidth="860" MinHeight="520">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizaBIM;component/UI/Styles.xaml"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="SvWindow"/>
    </Window.Style>
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" x:Name="TxtHeader" Style="{StaticResource Title}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Quantidades calculadas a partir da geometria gerada, separadas por categoria. Área pintada para tintas; área em planta para concreto, grama e demais elementos físicos. Consumos são estimativas com base no catálogo de materiais."/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CbCategory" Width="340" SelectionChanged="FilterChanged"/>
            <TextBlock Text="Pesquisar" Style="{StaticResource FieldLabel}" Margin="16,3,8,3"/>
            <TextBox x:Name="TbSearch" TextChanged="FilterChanged" ToolTip="Código, descrição, cor ou material"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Exportar CSV (Excel)" Click="ExportClick" ToolTip="Exporta a categoria/pesquisa atual, separada por categoria com subtotais."/>
            <Button Content="Criar tabela no Revit" Click="ScheduleClick" ToolTip="Tabela 'SV - Quantitativos' agrupada por categoria, com subtotais (parâmetros SV_*)."/>
            <Button Content="Tabelas por categoria" Click="SchedulesByCategoryClick" ToolTip="Cria uma tabela do Revit para cada categoria existente no projeto."/>
            <Button Content="Fechar" IsCancel="True" Style="{StaticResource Primary}"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="Itens por categoria">
                <DataGrid x:Name="GridRows" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}" Margin="4,8,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Grupo" Binding="{Binding GroupName}" Width="170"/>
                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="80"/>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Quantidade" Binding="{Binding MainQuantity, StringFormat=N2, ConverterCulture=pt-BR}" Width="85"/>
                        <DataGridTextColumn Header="Un." Binding="{Binding Unit}" Width="45"/>
                        <DataGridTextColumn Header="Cor" Binding="{Binding Color}" Width="70"/>
                        <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="150"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area, StringFormat=N2, ConverterCulture=pt-BR}" Width="80"/>
                        <DataGridTextColumn Header="Tipo de área" Binding="{Binding AreaKind}" Width="80"/>
                        <DataGridTextColumn Header="Extensão (m)" Binding="{Binding PaintedLength, StringFormat=N2, ConverterCulture=pt-BR}" Width="90"/>
                        <DataGridTextColumn Header="Unid." Binding="{Binding Units}" Width="50"/>
                        <DataGridTextColumn Header="Consumo" Binding="{Binding MaterialConsumption, StringFormat=N2, ConverterCulture=pt-BR}" Width="75"/>
                        <DataGridTextColumn Header="Un. cons." Binding="{Binding ConsumptionUnit}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Resumo por categoria">
                <DataGrid x:Name="GridCategories" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Categoria" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area, StringFormat=N2, ConverterCulture=pt-BR}" Width="110"/>
                        <DataGridTextColumn Header="Extensão (m)" Binding="{Binding PaintedLength, StringFormat=N2, ConverterCulture=pt-BR}" Width="110"/>
                        <DataGridTextColumn Header="Unidades" Binding="{Binding Units}" Width="90"/>
                        <DataGridTextColumn Header="Elementos" Binding="{Binding Elements}" Width="90"/>
                        <DataGridTextColumn Header="Consumo de tinta" Binding="{Binding MaterialConsumption, StringFormat=N2, ConverterCulture=pt-BR}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Pintura por cor e material">
                <DataGrid x:Name="GridSummary" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cor" Binding="{Binding Color}" Width="90"/>
                        <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*"/>
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area, StringFormat=N2, ConverterCulture=pt-BR}" Width="100"/>
                        <DataGridTextColumn Header="Consumo" Binding="{Binding MaterialConsumption, StringFormat=N2, ConverterCulture=pt-BR}" Width="100"/>
                        <DataGridTextColumn Header="Un." Binding="{Binding ConsumptionUnit}" Width="60"/>
                        <DataGridTextColumn Header="Microesferas (kg)" Binding="{Binding GlassBeadsKg, StringFormat=N2, ConverterCulture=pt-BR}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
