<Window x:Class="SinalizacaoViaria.Revit.UI.QuantitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quantitativos de sinalização horizontal" Width="1180" Height="700" MinWidth="800" MinHeight="480">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/SinalizacaoViaria;component/UI/Styles.xaml"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="SvWindow"/>
    </Window.Style>
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" x:Name="TxtHeader" Style="{StaticResource Title}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Áreas calculadas a partir da geometria gerada (sem sobreposições). Consumos são estimativas com base no catálogo de materiais."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Exportar CSV (Excel)" Click="ExportClick"/>
            <Button Content="Criar tabela no Revit" Click="ScheduleClick" ToolTip="Cria a tabela 'SV - Quantitativos' (Modelos genéricos) com os parâmetros SV_*."/>
            <Button Content="Fechar" IsCancel="True" Style="{StaticResource Primary}"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="GridRows" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Grupo" Binding="{Binding GroupName}" Width="150"/>
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="70"/>
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Cor" Binding="{Binding Color}" Width="70"/>
                    <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="170"/>
                    <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area, StringFormat=N2, ConverterCulture=pt-BR}" Width="80"/>
                    <DataGridTextColumn Header="Extensão (m)" Binding="{Binding PaintedLength, StringFormat=N2, ConverterCulture=pt-BR}" Width="90"/>
                    <DataGridTextColumn Header="Unid." Binding="{Binding Units}" Width="50"/>
                    <DataGridTextColumn Header="Elem." Binding="{Binding Elements}" Width="50"/>
                    <DataGridTextColumn Header="Consumo" Binding="{Binding MaterialConsumption, StringFormat=N2, ConverterCulture=pt-BR}" Width="75"/>
                    <DataGridTextColumn Header="Un." Binding="{Binding ConsumptionUnit}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="Resumo por cor e material" Style="{StaticResource Title}" Margin="0,10,0,4"/>
            <DataGrid Grid.Row="2" x:Name="GridSummary" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cor" Binding="{Binding Color}" Width="90"/>
                    <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*"/>
                    <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area, StringFormat=N2, ConverterCulture=pt-BR}" Width="100"/>
                    <DataGridTextColumn Header="Consumo" Binding="{Binding MaterialConsumption, StringFormat=N2, ConverterCulture=pt-BR}" Width="100"/>
                    <DataGridTextColumn Header="Un." Binding="{Binding ConsumptionUnit}" Width="60"/>
                    <DataGridTextColumn Header="Microesferas (kg)" Binding="{Binding GlassBeadsKg, StringFormat=N2, ConverterCulture=pt-BR}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
