<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 roda sobre .NET 10 (o runtime já vem com o Revit; o SDK só é necessário para compilar). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SinalizacaoViaria.Revit</RootNamespace>
    <AssemblyName>SinalizacaoViaria</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- DLL única: sem .deps.json nem dependências soltas. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
    <RevitVersion>2027</RevitVersion>
    <!-- Compila contra a 1ª versão do Revit 2027: a DLL carrega em todas as atualizações 2027.x
         (a versão do assembly RevitAPI muda a cada atualização e o .NET exige versão igual ou maior). -->
    <RevitApiVersion>2027.0.0</RevitApiVersion>
    <!-- Copia automaticamente para a pasta de Add-ins do Revit ao compilar no Windows -->
    <DeployToRevit Condition="'$(DeployToRevit)' == ''">true</DeployToRevit>
    <!-- Pasta pronta para copiar e colar (atualizada nas compilações Release) -->
    <PackageDir>$(MSBuildThisFileDirectory)..\..\Instalar\Revit$(RevitVersion)\</PackageDir>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referências da API do Revit 2027 (somente compilação; em execução o Revit fornece as DLLs) -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- O núcleo (e o Clipper2 incorporado) é compilado dentro desta mesma DLL. -->
  <ItemGroup>
    <Compile Include="..\SinalizacaoViaria.Core\**\*.cs"
             Exclude="..\SinalizacaoViaria.Core\bin\**;..\SinalizacaoViaria.Core\obj\**"
             Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\SinalizacaoViaria.Core\Catalog\catalogo-padrao.json"
                      LogicalName="SinalizacaoViaria.Core.catalogo-padrao.json"
                      Link="Core\Catalog\catalogo-padrao.json" />
    <!-- Os projetos WPF não incluem System.IO nas importações implícitas; o núcleo precisa dele. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SinalizacaoViaria.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Compilação Release: atualiza a pasta Instalar\Revit2027 (DLL + .addin) -->
  <Target Name="PackageAddin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SinalizacaoViaria.addin" DestinationFolder="$(PackageDir)" />
    <Message Importance="high" Text="Pacote pronto em $(PackageDir)" />
  </Target>

  <!-- Windows: copia DLL + .addin direto para %AppData%\Autodesk\Revit\Addins\2027 -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' And '$(DeployToRevit)' == 'true'">
    <PropertyGroup>
      <AddinRoot>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinRoot>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SinalizacaoViaria.addin" DestinationFolder="$(AddinRoot)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Message Importance="high" Text="Plugin copiado para $(AddinRoot)" />
  </Target>

</Project>
